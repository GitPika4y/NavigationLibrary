<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:Example.ViewModels.Main.Options"
             x:DataType="viewModel:GeneralOptionsViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Example.Views.Main.Options.GeneralOptionsView">
	<StackPanel>
		<TextBlock Text="We in general options" />
		<Button Content="Go to Main view"
		        Command="{Binding NavigateToMainViewCommand}" />
	</StackPanel>
</UserControl>